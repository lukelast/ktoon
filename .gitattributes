#
# https://help.github.com/articles/dealing-with-line-endings/
#
# Enforce LF line endings for all text files
* text=auto eol=lf

# Binary files should be left untouched
*.jar           binary
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary
*.zip           binary
*.gz            binary
*.class         binary
*.so            binary
*.dll           binary
*.exe           binary

